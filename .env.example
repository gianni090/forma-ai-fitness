# PostgreSQL for Prisma. For Supabase use a server-side connection URL.
DATABASE_URL="postgresql://forma:forma@127.0.0.1:5433/forma?schema=public"
# Canonical browser URL (used for auth emails and origin checks).
APP_URL="http://localhost:3000"
# Supabase Project Settings -> API: project URL and publishable key (NOT service_role).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Only for local development. Always disabled in production by the application.
AUTH_DEMO_MODE="false"
AI_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-120b"
AI_TIMEOUT_MS="90000"
AI_DAILY_LIMIT="10"
# Optional local AI mode; not used in production.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

