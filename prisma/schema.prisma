generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  authId    String   @unique
  createdAt DateTime @default(now())
  name      String   @default("Спортсмен")
  weeklyGoal Int     @default(3)
  timezone String    @default("Europe/Moscow")
  questionnaire Json?
  activeProgramId String?
  programs  Program[]
  sessions  WorkoutSession[]
  aiRuns    AiRun[]
  feedback  Feedback[]
}

model Exercise {
  id          String         @id @default(cuid())
  name        String
  muscleGroup String
  equipment   String
  planExercises PlanExercise[]
  sessionExercises SessionExercise[]
  @@unique([name, equipment])
}

model Program {
  id          String        @id @default(cuid())
  userId      String
  name        String
  createdAt   DateTime      @default(now())
  archivedAt  DateTime?
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planWorkouts PlanWorkout[]
  versions    ProgramVersion[]
  @@index([userId, createdAt])
}

model PlanWorkout {
  id        String @id @default(cuid())
  programId String
  title     String
  dayOfWeek Int
  focus     String @default("")
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises PlanExercise[]
  sessions  WorkoutSession[]
  @@index([programId, dayOfWeek])
}

model PlanExercise {
  id            String @id @default(cuid())
  planWorkoutId String
  exerciseId    String
  order         Int
  targetSets    Int
  targetReps    String
  restSeconds   Int
  metric        String @default("reps")
  notes         String @default("")
  muscleGroup   String @default("")
  planWorkout   PlanWorkout @relation(fields: [planWorkoutId], references: [id], onDelete: Cascade)
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  @@index([planWorkoutId, order])
}

model WorkoutSession {
  id            String @id @default(cuid())
  userId        String
  planWorkoutId String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  cancelledAt   DateTime?
  title         String @default("")
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planWorkout   PlanWorkout? @relation(fields: [planWorkoutId], references: [id])
  exercises     SessionExercise[]
  feedback      Feedback[]
  @@index([userId, startedAt])
}

model SessionExercise {
  id        String @id @default(cuid())
  sessionId String
  exerciseId String
  order     Int
  targetSets Int @default(0)
  targetReps String @default("")
  restSeconds Int @default(60)
  metric String @default("reps")
  notes String @default("")
  muscleGroup String @default("")
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise  Exercise @relation(fields: [exerciseId], references: [id])
  sets      SetLog[]
  @@unique([sessionId, exerciseId])
}

model SetLog {
  id               String @id @default(cuid())
  sessionExerciseId String
  reps             Int
  weight           Decimal
  completedAt      DateTime @default(now())
  durationSeconds  Int?
  clientKey        String?
  sessionExercise  SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  @@index([sessionExerciseId])
  @@unique([sessionExerciseId, clientKey])
}

model ProgramVersion {
  id        String   @id @default(cuid())
  programId String
  version   Int
  source    String
  data      Json
  createdAt DateTime @default(now())
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  @@unique([programId, version])
}

model AiRun {
  id        String   @id @default(cuid())
  userId    String?
  provider  String
  model     String
  inputHash String
  output    Json?
  status    String
  latencyMs Int
  error     String?
  createdAt DateTime @default(now())
  requestKey String? @unique
  programId String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([inputHash])
}

model RateLimit {
  key String @id
  count Int
  resetAt DateTime
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  sessionId String?
  rating    Int
  effort    Int
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

